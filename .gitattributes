# Normalize line endings: Windows agents, Antigravity and Linux CI all see LF in text files.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.fmu binary
*.zip binary
*.mp4 binary
*.wav binary
