META_API_KEY=replace-with-your-meta-model-api-key
META_API_BASE_URL=https://api.meta.ai/v1
META_API_TIMEOUT_SECONDS=90
META_API_MAX_RETRIES=1
SAM_MODEL=sam-3.1
SCENE_MODEL=muse-spark-1.3
DECISION_MODEL=muse-wonder-1.0
VOICE_MODEL=muse-voice-transcribe-1.0
IMAGE_MODEL=muse-image-1.0
SAM_PERSON_CONCEPT=humans
SAM_SECONDARY_CONCEPT=fan
SCENE_ANALYSIS_PROMPT=Evaluate room thermal load parameters across these frames.
DECISION_REASONING_EFFORT=minimal
CONTROL_SYSTEM_INSTRUCTIONS=You are an automated ASHRAE building management controller. Analyze numeric zone sensor telemetry and active HVAC setpoints. Return the JSON setpoint delta. Set unchanged parameters to null.
TARGET_CONTROL_VARIABLES={"target_temperature_c":24,"target_humidity_pct":45,"target_co2_ppm":800,"target_set_pm25_ug_m3":10,"target_pm10_ug_m3":20,"target_tvoc_ppb":250}
INITIAL_CONTROL_VARIABLES={"target_temperature_c":30,"target_humidity_pct":35,"target_co2_ppm":900,"target_set_pm25_ug_m3":15,"target_pm10_ug_m3":25,"target_tvoc_ppb":300}
INITIAL_MANIPULATED_VARIABLES={"temperature_c":24.0,"fan_speed_mode":"AUTO","fan_mode":"AUTO","airflow_rate_m3h":500.0,"louver_vertical_deg":60,"louver_horizontal_deg":90,"swing_mode":false,"compressor_mode":"COOL","compressor_frequency_hz":40.0,"valve_open_pct":50,"eco_mode":false,"sleep_mode":false,"turbo_mode":false,"humidity_target_pct":50.0,"dehumidification_mode":false,"fresh_air_damper_pct":0,"ventilation_mode":"AUTO","filter_cleaning_alert":false,"defrost_mode":false}

# SpotCool Cortex pipeline (PIPELINE_MODE=legacy runs the original MVP path).
PIPELINE_MODE=cortex
CORTEX_FALLBACK_TO_LEGACY=true
PIPELINE_DEADLINE_SECONDS=220
ANALYSIS_SAMPLE_INTERVAL_SECONDS=0.5
MAX_ANALYSIS_FRAMES=240
KEYFRAMES_PER_CLIP=4
ANALYSIS_MAX_SIDE=1280
SAM_DOOR_CONCEPT=open door
SAM_CONTEXT_CONCEPTS=["open window","computer monitor","ceiling fan"]
SAM_MAX_CONCURRENCY=6
SAM_MIN_CONFIDENCE=0.3
SCENE_REASONING_EFFORT=low
SUPERVISOR_REASONING_EFFORT=medium
DECISION_MAX_TOOL_ROUNDS=3
VOICE_TRANSCRIPTION_ENABLED=true
PRIVACY_BLUR_FACES=true
PRIVACY_RENDER_ENABLED=true
SAVE_DECISION_OVERLAY=true
# Physics parameters: JSON objects merged over the defaults in app/spotcool/config.py.
ZONE_PARAMETERS={"floor_area_m2":120,"ceiling_height_m":3.0,"outdoor_temperature_c":32,"outdoor_rh_pct":60,"space_type":"auto"}
HVAC_PARAMETERS={"rated_cooling_kw":12,"rated_cop":3.2,"max_airflow_m3h":1800,"max_fresh_air_m3h":1200}
CAMERA_PARAMETERS={"mount_height_m":2.8,"tilt_down_deg":30,"horizontal_fov_deg":90,"ac_height_m":2.6}
CONTROL_PARAMETERS=
BASELINE_MANIPULATED_VARIABLES={"fan_speed_mode":"HIGH","fresh_air_damper_pct":60}

RABBITMQ_DEFAULT_USER=spotcool
RABBITMQ_DEFAULT_PASS=change-this-local-password
RABBITMQ_USER=spotcool
RABBITMQ_PASSWORD=change-this-local-password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_RECONNECT_INTERVAL_SECONDS=5
RABBITMQ_MANAGEMENT_PORT=15672

JOB_QUEUE_NAME=spotcool.jobs
RESULT_QUEUE_NAME=spotcool.results
WORKER_CONCURRENCY=2
LOG_LEVEL=INFO
JOB_TIMEOUT_SECONDS=300
CLIP_DURATION_SECONDS=60
FRAME_SAMPLE_INTERVAL_SECONDS=2
MAX_FRAMES_PER_CLIP=30
JPEG_QUALITY=85
TURN_HISTORY_LENGTH=3
TURN_DETAILS_DIRECTORY=turn_details
VIDEO_PATH=
VIDEO_HOST_DIRECTORY=./videos
VIDEO_WORKER_DIRECTORY=/videos
